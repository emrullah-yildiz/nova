{
  "permissions": {
    "allow": [
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-secrets.mjs",
            "if": "Bash(git commit*)",
            "timeout": 30,
            "statusMessage": "Scanning staged changes for secrets…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-on-stop.mjs",
            "timeout": 120,
            "statusMessage": "Validating changed files…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-on-stop.mjs",
            "timeout": 120,
            "statusMessage": "Validating subagent output…"
          }
        ]
      }
    ]
  }
}
