# Nova Cloudflare Worker environment example
#
# Copy secret values into Cloudflare Worker secrets or a local `.env.local`.
# Do not commit real environment files.

# Public runtime origins are defined in wrangler.toml:
#   production: https://hi-nova.work
#   dev:        https://nova-dev.e-y-myacc.workers.dev

# Required secrets
NOVA_SESSION_SECRET=replace-with-a-long-random-secret
NOVA_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional email verification
RESEND_API_KEY=
NOVA_EMAIL_FROM=Nova <noreply@hi-nova.work>

# OIDC authentication
#
# GOOGLE_CLIENT_ID is public and currently lives in wrangler.toml.
# Provider secrets, if added later, must be Worker secrets.
NOVA_OIDC_ISSUER=https://accounts.google.com
NOVA_OIDC_CLIENT_ID=

# Local development only. Keep false in shared dev and production.
NOVA_ALLOW_DEV_LOGIN=false

# AI provider secrets
#
# Set these as Cloudflare Worker secrets. The browser must never receive them.
GROQ_API_KEY=
NOVA_GROQ_API_KEY=
NOVA_GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
NOVA_GEMINI_API_KEY=
NOVA_GEMINI_MODEL=gemini-2.0-flash

NOVA_OPENAI_API_KEY=
NOVA_OPENAI_MODELS=gpt-4o,gpt-4o-mini

NOVA_OPENROUTER_API_KEY=
NOVA_OPENROUTER_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-4o,openrouter/free

# Feedback endpoint
#
# Used by /api/feedback/refusals to create GitHub issues from opted-in AI
# refusal feedback.
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_REPO=emrullah-yildiz/nova
FEEDBACK_RATE_LIMIT=6

# Cloudflare bindings are configured in wrangler.toml:
# - ASSETS
# - SESSION_KV
# - RATE_KV
# - PROJECT_ROOM
#
# Create dev-only KV namespaces when possible so `develop` does not share
# session/rate-limit state with production.
