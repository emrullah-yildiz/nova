# Nova Enterprise API example environment
#
# Copy these values into your deployment secret manager or a local .env file.
# Do not commit real environment files.

NOVA_API_HOST=127.0.0.1
NOVA_API_PORT=8787
NOVA_CORS_ORIGIN=http://127.0.0.1:8080
NOVA_SESSION_SECRET=replace-with-a-long-random-secret
NOVA_PUBLIC_APP_URL=http://127.0.0.1:8080

# Dev login (local development only — OFF by default for safety).
# Set to "true" to enable the /api/auth/dev-login endpoint.
# Production deployments must keep this OFF and use OIDC instead.
# NOVA_ALLOW_DEV_LOGIN=true

# Persistence mode: choose one.
#
# Option 1: Postgres (production)
#   Set NOVA_DATABASE_URL to a Postgres connection string.
#   Requires: `npm run migrate` or `npm run db:migrate` to run migrations.
#
# NOVA_DATABASE_URL=postgres://user:password@localhost:5432/nova?sslmode=require

# Option 2: JSON file persistence (local dev / demos only)
#   Set NOVA_ENTERPRISE_STORE_FILE to a writable file path.
#   Not suitable for production (no concurrent writer coordination, indexes, or backup).
#
# NOVA_ENTERPRISE_STORE_FILE=.nova-data/enterprise-store.json

# Redis state store (production)
#
# Required for horizontally-scaled API containers. Stores short-lived auth
# sessions, connector pairing state, and AI rate-limit counters.
#
# NOVA_REDIS_URL=rediss://default:password@your-redis-host:6379/0

# OIDC Authentication (for production SSO)
#
# To enable real OIDC-based login, set both:
#   NOVA_OIDC_ISSUER  — The OpenID issuer URL (e.g., https://accounts.google.com)
#   NOVA_OIDC_CLIENT_ID — The client ID assigned to your Nova app by the provider
#
# Examples:
#   Google:    NOVA_OIDC_ISSUER=https://accounts.google.com
#   GitHub:    NOVA_OIDC_ISSUER=https://token.actions.githubusercontent.com
#   Auth0:     NOVA_OIDC_ISSUER=https://your-tenant.eu.auth0.com
#   Keycloak:  NOVA_OIDC_ISSUER=https://auth.your-company.com/realms/your-realm
#
# When set, the OIDC callback endpoint (/api/auth/oidc/callback) validates
# ID tokens using the provider's JWKS (public keys) — no extra dependencies.
#
# NOVA_OIDC_ISSUER=
# NOVA_OIDC_CLIENT_ID=

# AI provider secrets (server-side only).
#
# Set one or more provider keys to enable those providers in organization policy.
# The browser should call /api/ai/chat and must not store these keys in localStorage.
#
# NOVA_OPENAI_API_KEY=
# NOVA_OPENAI_MODELS=gpt-4o,gpt-4o-mini
#
# NOVA_GROQ_API_KEY=
# NOVA_GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
#
# NOVA_OPENROUTER_API_KEY=
# NOVA_OPENROUTER_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-4o,openrouter/free

# Frontend enterprise AI flag:
#   VITE_NOVA_ENTERPRISE_AI_ENABLED=true
