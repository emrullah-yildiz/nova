{
  "name": "nodeflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based visual scripting and parametric design prototype with AI-assisted node workflows.",
  "main": "index.html",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite",
    "dev:api": "node scripts/enterprise-api.mjs",
    "dev:cloud:api": "node scripts/dev-cloud-api.mjs",
    "dev:neon:api": "node scripts/dev-neon-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "release:check": "npm run test && npm run build && npm audit --audit-level=moderate",
    "lint": "eslint tests/ --ext .js --ignore-path .gitignore",
    "lint:app": "eslint src/ --ext .js --ignore-path .gitignore",
    "lint:tests": "eslint tests/ --ext .js --ignore-path .gitignore",
    "lint:src": "eslint src/ --ext .js --ignore-path .gitignore",
    "lint:formula": "eslint src/core/formula-eval.js --ignore-path .gitignore",
    "lint:all": "eslint . --ext .js --ignore-path .gitignore",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres-persistence.integration.test.js",
    "test:e2e": "node scripts/run-e2e.cjs",
    "migrate": "node scripts/run-migrations.mjs",
    "migrate:neon": "node scripts/migrate-neon.mjs",
    "db:migrate": "node scripts/run-migrations.mjs"
  },
  "keywords": [
    "visual-scripting",
    "parametric-design",
    "ai",
    "3d",
    "geometry",
    "node-editor"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "pg": "^8.21.0",
    "ws": "^8.20.1"
  }
}
